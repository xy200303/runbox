{
  "name": "runbox-sdk",
  "version": "0.2.3",
  "description": "Node.js client for Runbox, a lightweight sandbox for agent commands and files",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "runbox",
    "sandbox",
    "agent",
    "code-execution"
  ],
  "homepage": "https://runbox.xyun.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xy200303/runbox.git",
    "directory": "sdk/node"
  },
  "bugs": {
    "url": "https://github.com/xy200303/runbox/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
